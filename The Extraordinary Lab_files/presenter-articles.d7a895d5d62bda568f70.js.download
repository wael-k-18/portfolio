  display: flex;
  position: absolute;
  top: 3.5rem;
  bottom: 0;
  flex-direction: column;
  width: 100%;

  @media (min-width: 1024px) {
    padding-top: 55px;
  }

  .game-container {
    min-height: 400px;
  }

  .puzzles-and-games-game-loader {
    display: flex;
    justify-content: center;
    background: #ffe17d;
    padding-top: 34px;
    height: 100%;
  }

  .puzzles-and-games-progress-wrapper {
    margin: 0 16px;
    border-radius: 100px;
    background: #fffefc;
    width: 100%;
    max-width: 362px;
    height: 8px;
    overflow: hidden;
  }

  .puzzles-and-games-progress-bar {
    transition: width 0.3s ease-in-out;
    animation: shuffalo-loading 6s infinite;
    background: #000;
    width: 1%;
    height: 8px;
  }

  @keyframes shuffalo-loading {
    0% {
      width: 1%;
    }

    50% {
      width: 50%;
    }

    100% {
      width: 100%;
    }
  }

  .page {
    min-height: 100dvh;
  }
