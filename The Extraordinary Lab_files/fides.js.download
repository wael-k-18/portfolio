aboola","system_fides_key":"taboola_8317ab1d-23cf-4bb9-a9b1-381975965cc1"},{"name":"tb_click_param","domain":"[\"*\"]","data_uses":["functional.service.improve","functional.storage","analytics.reporting.content_performance"],"description":null,"duration":null,"system_name":"Taboola","system_fides_key":"taboola_8317ab1d-23cf-4bb9-a9b1-381975965cc1"}],"systems_applicable":true,"translations":[{"language":"en","title":"Audience Measurement","description":"We use audience measurement cookies in order to carry out aggregated traffic measurement and generate performance statistics essential for the proper functioning of the site and the provision of its content (for example to measure performance, to detect navigation problems, to optimization technical performance or ergonomics, to estimate server power needed and to analyse content performance). The use of these cookies is strictly limited to measuring the site's audience. These cookies do not allow the tracking of navigation on other websites and the data collected is not combined or shared with third parties. You can refuse the use of this cookie by switching off the slider to the right.","privacy_notice_history_id":"pri_1d6075b9-5190-4684-90f0-f446448246c9"}],"children":[],"gpp_field_mapping":null}],"non_applicable_privacy_notices":[],"experience_config":{"name":"NON REGULATED REGIONS","disabled":false,"dismissable":false,"show_layer1_notices":false,"layer1_button_options":"opt_in_opt_out","allow_language_selection":true,"auto_detect_language":true,"auto_subdomain_cookie_deletion":true,"cookie_deletion_based_on_host_domain":true,"resurface_behavior":[],"allow_vendor_asset_disclosure":false,"asset_disclosure_include_types":null,"regions":["global"],"tcf_configuration_id":null,"id":"pri_0c9108a4-c844-4651-9634-e03e2834c74f","created_at":"2025-04-11T18:50:19.593173Z","updated_at":"2025-06-05T20:31:02.650381Z","component":"modal","translations":[{"language":"en","accept_button_label":"Accept","acknowledge_button_label":"OK","banner_title":null,"gpc_label":"Global Privacy Control","gpc_description":"We have detected your Global Privacy Control signal and will honor your preferences accordingly.","gpc_status_applied_label":"Applied","gpc_status_overridden_label":"Overridden","gpc_title":"Global Privacy Control detected","gpc_prompt_title":null,"gpc_prompt_description":null,"gpc_prompt_cta_button_label":null,"is_default":true,"modal_link_label":"Privacy Information","privacy_policy_link_label":"Privacy Policy","privacy_policy_url":"https://www.condenast.com/privacy-policy","privacy_preferences_link_label":"Privacy Preferences","purpose_header":null,"reject_button_label":"Reject","save_button_label":"Save","title":"Privacy Center","implications_title":null,"implications_message":null,"opted_out_notices_label":null,"opt_out_success_title":null,"opt_out_success_message":null,"identity_opt_out_success_title":null,"identity_opt_out_success_message":null,"close_button_label":null,"banner_description":null,"description":"Currently, only residents from GDPR countries and certain US states can opt out of Tracking Technologies through our Consent Management Platform. Additional options regarding these technologies may be available on your device, browser, or through industry options like AdChoices. Please see our Privacy Policy for more information.\n","privacy_experience_config_history_id":"pri_2c9b875f-6409-4dcd-b4ba-82d1c7914692"},{"language":"de","accept_button_label":"OK","acknowledge_button_label":"OK","banner_title":null,"gpc_label":"Globale Datenschutzeinstellungen","gpc_description":"Ihre globale Datenschutzeinstellungen werden berücksichtigt. Sie wurden automatisch von Anwendungsfällen ausgenommen, die nicht Ihren globalen Datenschutzeinstellungen unterliegen.","gpc_status_applied_label":"Angewendet","gpc_status_overridden_label":"Überschrieben","gpc_title":"Globale Datenschutzkontrolle erkannt","gpc_prompt_title":null,"gpc_prompt_description":null,"gpc_prompt_cta_button_label":null,"is_default":false,"modal_link_label":null,"privacy_policy_link_label":null,"privacy_policy_url":null,"privacy_preferences_link_label":null,"purpose_header":null,"reject_button_label":"ABLEHNEN","save_button_label":"Meine Auswahl bestätigen","title":"Datenschutzcenter","implications_title":null,"implications_message":null,"opted_out_notices_label":null,"opt_out_success_title":null,"opt_out_success_message":null,"identity_opt_out_success_title":null,"identity_opt_out_success_message":null,"close_button_label":null,"banner_description":null,"description":"Derzeit können nur Einwohner bestimmter Länder und US-Bundesstaaten bestimmte Tracking-Technologien über unsere Consent Management Platform deaktivieren. Weitere Optionen zu diesen Technologien sind möglicherweise auf Ihrem Gerät, in Ihrem Browser oder über Branchenoptionen wie AdChoices verfügbar. Weitere Informationen finden Sie in unserer Datenschutzerklärung.\n","privacy_experience_config_history_id":"pri_8965b721-f3a1-4783-9d2e-a70593cc6dce"},{"language":"it","accept_button_label":"ACCETTO","acknowledge_button_label":"OK","banner_title":null,"gpc_label":"Controllo Globale della Privacy","gpc_description":"Le tue preferenze del Controllo Globale della Privacy sono state prese in carico. Sei stato automaticamente escluso dai casi di utilizzo dei dati che corrispondono al Controllo Globale della Privacy.","gpc_status_applied_label":"Applicato","gpc_status_overridden_label":"Non applicato","gpc_title":"Rilevato il controllo della privacy globale","gpc_prompt_title":null,"gpc_prompt_description":null,"gpc_prompt_cta_button_label":null,"is_default":false,"modal_link_label":null,"privacy_policy_link_label":null,"privacy_policy_url":null,"privacy_preferences_link_label":null,"purpose_header":null,"reject_button_label":"RIFIUTARE TUTTO","save_button_label":"Conferma le mie scelte","title":"Centro sulla privacy","implications_title":null,"implications_message":null,"opted_out_notices_label":null,"opt_out_success_title":null,"opt_out_success_message":null,"identity_opt_out_success_title":null,"identity_opt_out_success_message":null,"close_button_label":null,"banner_description":null,"description":"Attualmente, solo i residenti di determinati Paesi e stati degli Stati Uniti possono disattivare alcune Tecnologie di Tracciamento tramite la nostra Piattaforma di Gestione del Consenso. Ulteriori opzioni relative a queste tecnologie potrebbero essere disponibili sul tuo dispositivo, browser o tramite opzioni di settore come AdChoices. Per ulteriori informazioni, consulta la nostra Informativa sulla Privacy.\n","privacy_experience_config_history_id":"pri_029998d4-bddc-4df9-8697-98a575efcdd0"},{"language":"fr","accept_button_label":"ACCEPTER","acknowledge_button_label":" D'ACCORD","banner_title":null,"gpc_label":"Global Privacy Control","gpc_description":"Votre préférence en matière de contrôle global de la confidentialité (GPC) a été respectée. Vous avez automatiquement été retiré des cas d’usage des données qui adhèrent au GPC.","gpc_status_applied_label":"Appliqué","gpc_status_overridden_label":"Ignoré","gpc_title":"Contrôle global de la confidentialité détecté","gpc_prompt_title":null,"gpc_prompt_description":null,"gpc_prompt_cta_button_label":null,"is_default":false,"modal_link_label":null,"privacy_policy_link_label":null,"privacy_policy_url":null,"privacy_preferences_link_label":"GÉRER MES COOKIES","purpose_header":null,"reject_button_label":"TOUT REFUSER","save_button_label":"Confirmer la sélection","title":"Centre de confidentialité","implications_title":null,"implications_message":null,"opted_out_notices_label":null,"opt_out_success_title":null,"opt_out_success_message":null,"identity_opt_out_success_title":null,"identity_opt_out_success_message":null,"close_button_label":null,"banner_description":null,"description":"Actuellement, seuls les résidents de certains pays et États américains peuvent désactiver certaines technologies de suivi via notre plateforme de gestion du consentement. Des options supplémentaires concernant ces technologies peuvent être disponibles sur votre appareil, votre navigateur ou via des options sectorielles comme AdChoices. Veuillez consulter notre Politique de confidentialité pour plus d'informations.","privacy_experience_config_history_id":"pri_56c6541f-5fc9-49e9-998c-61d06804c946"},{"language":"es","accept_button_label":"ACEPTAR","acknowledge_button_label":"DE ACUERDO","banner_title":null,"gpc_label":"Control de privacidad global","gpc_description":"Su preferencia de control de privacidad global se ha respetado. Se le ha excluido automáticamente de los casos de uso de datos que se adhieren al control de privacidad global.","gpc_status_applied_label":"Aplicado","gpc_status_overridden_label":"Anulado","gpc_title":"Control de privacidad global detectado","gpc_prompt_title":null,"gpc_prompt_description":null,"gpc_prompt_cta_button_label":null,"is_default":false,"modal_link_label":null,"privacy_policy_link_label":null,"privacy_policy_url":null,"privacy_preferences_link_label":"GESTIONAR MI CONFIGURACIÓN","purpose_header":null,"reject_button_label":"RECHAZAR","save_button_label":"Confirmar mis preferencias","title":"Centro de privacidad","implications_title":null,"implications_message":null,"opted_out_notices_label":null,"opt_out_success_title":null,"opt_out_success_message":null,"identity_opt_out_success_title":null,"identity_opt_out_success_message":null,"close_button_label":null,"banner_description":null,"description":"Actualmente, solo los residentes de ciertos países y estados de EE. UU. pueden optar por no usar ciertas Tecnologías de Rastreo a través de nuestra Plataforma de Gestión de Consentimiento. Puede que haya opciones adicionales disponibles para estas tecnologías en su dispositivo, navegador o a través de opciones del sector como AdChoices. Consulte nuestra Política de Privacidad para obtener más información.\n","privacy_experience_config_history_id":"pri_8587c6f6-af4c-4c59-8ccd-2cf84013fddd"},{"language":"ja